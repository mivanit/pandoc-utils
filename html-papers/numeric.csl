<?xml version="1.0" encoding="utf-8"?>
<!-- The HTML build's citations, made to look like the PDF's (biblatex's default numeric
     style): [n] in the text, numbered in bibliography order (author, title, year), more
     than three authors shortened to the first and "et al.", "In: Journal 27.2 (1984), pp.
     97-111". pandoc lower-cases a BibTeX title's words unless they are in braces: write
     title = {{Kept As Written}} for the title the PDF shows.
     From https://github.com/mivanit/pandoc-utils, html-papers/. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only">
  <info>
    <title>Numeric, like biblatex's default</title>
    <id>html-papers-numeric</id>
    <updated>2026-11-04T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name and="text" delimiter=", " delimiter-precedes-last="contextual" et-al-min="4" et-al-use-first="1"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
      </substitute>
    </names>
  </macro>
  <macro name="author-sort">
    <names variable="author">
      <name name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"/>
        <text variable="publisher"/>
      </substitute>
    </names>
  </macro>
  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="0">
    <sort>
      <key macro="author-sort"/>
      <key variable="title"/>
      <key macro="year"/>
    </sort>
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="author"/>
        <choose>
          <if type="article-journal article paper-conference chapter" match="any">
            <group delimiter=" ">
              <text variable="title" quotes="true" suffix="."/>
              <group delimiter=", ">
                <group delimiter=" ">
                  <text value="In:"/>
                  <text variable="container-title" font-style="italic"/>
                  <group delimiter=".">
                    <text variable="volume"/>
                    <text variable="issue"/>
                  </group>
                  <text macro="year" prefix="(" suffix=")"/>
                </group>
                <text variable="page" prefix="pp. "/>
              </group>
            </group>
          </if>
          <else>
            <group delimiter=". ">
              <text variable="title" font-style="italic"/>
              <text variable="publisher"/>
              <text macro="year"/>
            </group>
          </else>
        </choose>
        <text variable="URL" prefix="url: "/>
      </group>
    </layout>
  </bibliography>
</style>
